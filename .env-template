template for hvilke miljøvariabler som skal brukes. Kopier feltene under i en ".env.local" fil.

NEXT_PUBLIC_ENVIRONMENT="localhost"
MOCK_API_BASE_URL="http://localhost:8080"
BEHANDLING_API_BASE_URL="http://localhost:8080/behandlingsflyt"
BEHANDLING_API_SCOPE="dev-gcp:aap:behandlingsflyt"

MELDEKORT_API_BASE_URL="http://localhost:8080/meldekort-backend"
MELDEKORT_API_SCOPE="dev-gcp:aap:meldekort-backend"

OPPGAVE_API_BASE_URL="http://localhost:8080/oppgave"
OPPGAVE_API_SCOPE="dev-gcp:aap:oppgave"

UTBETAL_API_BASE_URL="http://localhost:8080/utbetal"
UTBETAL_API_SCOPE="dev-gcp:aap:utbetal"

DOKUMENTINNHENTING_API_BASE_URL="http://localhost:8080/dokumentinnhenting"
DOKUMENTINNHENTING_API_SCOPE="dokumentinnhenting"

POSTMOTTAK_API_BASE_URL="http://localhost:8080/postmottak"
POSTMOTTAK_API_SCOPE="dev-gcp:aap:postmottak-backend"

BREV_API_BASE_URL="http://localhost:8080/brev"
BREV_API_SCOPE="dev-gcp:aap:brev-backend"

STATISTIKK_API_BASE_URL="http://localhost:8080/statistikk"

API_INTERN_BASE_URL="http://localhost:8080/api-intern"
